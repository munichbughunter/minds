<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Minds witness ({{REPO_ID}}), generated by minds enable for the container profile.
     Load it yourself: launchctl bootstrap gui/$(id -u) <this file> -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>dev.minds.witness.{{REPO_ID}}</string>
	<key>ProgramArguments</key>
	<array>
		<string>{{EXE}}</string>
		<string>witness</string>
		<string>run</string>
		<string>--home</string>
		<string>{{HOME}}</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>Umask</key>
	<integer>63</integer>
</dict>
</plist>
