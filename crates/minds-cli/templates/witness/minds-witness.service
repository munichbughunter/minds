# Minds witness for {{ROOT_COMMENT}}
# Generated by `minds enable --witness container`. Enable it yourself:
#   systemctl --user daemon-reload
#   systemctl --user enable --now minds-witness-{{REPO_ID}}.service
[Unit]
Description=Minds witness ({{REPO_ID}})

[Service]
Type=simple
ExecStart={{EXEC}} witness run --home {{HOME}}
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=default.target
